{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CrashingGuru/Sandbox_Training/schema/metadata.schema.json",
  "title": "Dataset metadata",
  "description": "Source-of-truth metadata for a single dataset. DATASETS.md and datasets.json are generated from these files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "description", "version", "date_added", "license", "files"],
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL-safe id; MUST equal the dataset folder name.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name shown in the client.",
      "minLength": 1
    },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "description": "Semantic version, e.g. 1.0.0",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date_added": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD).",
      "format": "date"
    },
    "added_by": { "type": "string" },
    "source": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the dataset folder, e.g. data/foo.csv"
          },
          "rows": { "type": "integer", "minimum": 0 },
          "columns": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "lfs": {
            "type": "boolean",
            "description": "True if this file is stored via Git LFS (large file)."
          }
        }
      }
    }
  }
}
